# AveloHealth Backend Environment Variables

# Application
APP_NAME=AveloHealth
DEBUG=true

# Security (CHANGE THESE IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-me
ENCRYPTION_KEY=your-encryption-key-change-me

# Auth0 Configuration (for OAuth2 login)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://your-tenant.auth0.com/api/v2/

# Twilio Configuration (for phone/email verification)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_VERIFY_SERVICE_SID=your-verify-service-sid

# Snowflake Configuration (Optional for demo mode)
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=AVELOHEALTH_DB
SNOWFLAKE_SCHEMA=PUBLIC

# AI Services
# No external API keys needed - AI powered by Snowflake Cortex (mistral-large model)
