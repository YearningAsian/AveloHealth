# AveloHealth Backend Environment Variables

# Application
APP_NAME=AveloHealth
DEBUG=true

# Security (CHANGE THESE IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-me
ENCRYPTION_KEY=your-encryption-key-change-me

# Snowflake Configuration (Optional for demo mode)
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=AVELOHEALTH_DB
SNOWFLAKE_SCHEMA=PUBLIC

# AI Services (Optional)
GEMINI_API_KEY=your_gemini_api_key
